{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimx.local/contracts/research-update.schema.json",
  "title": "Aimx ResearchUpdate schema_version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_revision", "author", "operations"],
  "properties": {
    "schema_version": {"const": 1},
    "base_revision": {"type": "integer", "minimum": 0},
    "client_update_id": {"type": "string", "minLength": 1},
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {"enum": ["agent", "human", "system"]},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "message": {"type": "string"},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}}
  },
  "$defs": {
    "entityRef": {"type": "string", "minLength": 1, "description": "Durable ID or same-update reference such as $f1."},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["kind", "location"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "location": {"type": "string", "minLength": 1}, "note": {"type": "string"}}
    },
    "aimRunEvidence": {
      "type": "object", "additionalProperties": false, "required": ["kind", "run_hash"],
      "properties": {
        "kind": {"const": "aim_run"}, "run_hash": {"type": "string", "minLength": 1},
        "role": {"type": "string"}, "note": {"type": "string"},
        "evidence_type": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1},
        "source_activity_id": {"$ref": "#/$defs/entityRef"}
      }
    },
    "localArtifactEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "location", "sha256", "size_bytes", "evidence_type", "purpose", "source_activity_id"],
      "properties": {
        "kind": {"const": "local_artifact"}, "location": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 0},
        "evidence_type": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1},
        "source_activity_id": {"$ref": "#/$defs/entityRef"}
      }
    },
    "evidence": {"oneOf": [{"$ref": "#/$defs/aimRunEvidence"}, {"$ref": "#/$defs/localArtifactEvidence"}]},
    "textArray": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "experimentContract": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "question", "interventions", "fixed_controls", "expected_evidence", "disconfirmation", "confounders", "evaluation", "data", "resources", "failure_policy"],
      "properties": {
        "contract_version": {"const": 1},
        "question": {"type": "string", "minLength": 1},
        "interventions": {"$ref": "#/$defs/nonEmptyTextArray"},
        "fixed_controls": {"$ref": "#/$defs/nonEmptyTextArray"},
        "expected_evidence": {"$ref": "#/$defs/nonEmptyTextArray"},
        "disconfirmation": {"$ref": "#/$defs/nonEmptyTextArray"},
        "confounders": {"$ref": "#/$defs/textArray"},
        "evaluation": {"type": "object", "additionalProperties": false, "required": ["protocol_id", "protocol_sha256", "argv", "metric", "acceptance_rule", "preflight_evidence"], "properties": {"protocol_id": {"type": "string", "minLength": 1}, "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "argv": {"$ref": "#/$defs/nonEmptyTextArray"}, "metric": {"type": "string", "minLength": 1}, "acceptance_rule": {"type": "string", "minLength": 1}, "preflight_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}}},
        "data": {"type": "object", "additionalProperties": false, "required": ["scope_ids", "phase", "candidate_fingerprint", "observation_revision"], "properties": {"scope_ids": {"type": "array", "items": {"$ref": "#/$defs/entityRef"}}, "phase": {"enum": ["exploratory", "independent_confirmation"]}, "candidate_fingerprint": {"type": "string", "minLength": 1}, "observation_revision": {"type": "integer", "minimum": 0}}},
        "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
        "failure_policy": {"enum": ["stop_pending", "continue_independent"]},
        "extensions": {"type": "object", "properties": {"host_failure_policy_verified": {"type": "boolean"}, "host_failure_policy_preflight_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "allOf": [{"if": {"properties": {"host_failure_policy_verified": {"const": true}}, "required": ["host_failure_policy_verified"]}, "then": {"required": ["host_failure_policy_preflight_sha256"]}}]}
      }
    },
    "nonEmptyTextArray": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "resource": {"type": "object", "additionalProperties": false, "required": ["kind", "unit", "planned", "verification", "enforcement"], "properties": {"kind": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "planned": {"type": "number", "minimum": 0}, "actual": {"type": "number", "minimum": 0}, "verification": {"enum": ["verified", "unverified"]}, "enforcement": {"enum": ["executor_enforced", "declared_only", "unknown"]}, "source": {"type": "string", "minLength": 1}}},
    "operation": {
      "type": "object", "additionalProperties": false, "required": ["op"],
      "properties": {
        "op": {"enum": [
          "finding.create", "finding.assess", "finding.governance", "relation.create", "relation.retract", "annotation.create",
          "frontier.lane.create", "frontier.lane.rename", "frontier.lane.retire", "frontier.item.create", "frontier.item.move",
          "frontier.item.set_priority", "frontier.item.set_status", "frontier.item.update", "agenda.item.create", "agenda.item.transition",
          "agenda.item.attach_evidence", "agenda.item.set_priority", "activity.create", "activity.artifact.add", "evidence.review",
          "dataset.scope.create", "dataset.observation.record", "execution.outcome.record"
        ]},
        "local_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "source_activity_id": {"$ref": "#/$defs/entityRef"}, "finding_id": {"$ref": "#/$defs/entityRef"},
        "relation_id": {"$ref": "#/$defs/entityRef"}, "annotation_target_kind": {"enum": ["research_state", "finding", "relation", "frontier_item", "agenda_item"]},
        "annotation_target_id": {"$ref": "#/$defs/entityRef"}, "lane_id": {"$ref": "#/$defs/entityRef"},
        "frontier_item_id": {"$ref": "#/$defs/entityRef"}, "agenda_item_id": {"$ref": "#/$defs/entityRef"},
        "claim": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "epistemic_status": {"enum": ["candidate", "validated", "contradicted"]}, "confidence": {"enum": ["low", "medium", "high"]},
        "governance_status": {"enum": ["proposed", "accepted", "rejected"]}, "source": {"$ref": "#/$defs/source"},
        "target": {"$ref": "#/$defs/entityRef"}, "relation_type": {"enum": ["derived_from", "supports", "challenges", "refines", "supersedes", "tests", "related_to"]},
        "text": {"type": "string", "minLength": 1}, "reason": {"type": "string"}, "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"}, "direction": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100}, "frontier_status": {"enum": ["active", "paused", "retired"]},
        "objective": {"type": "string", "minLength": 1}, "hypothesis": {"type": "string"}, "question": {"type": "string"},
        "motivating_finding_ids": {"type": "array", "items": {"$ref": "#/$defs/entityRef"}},
        "frontier_item_ids": {"type": "array", "items": {"$ref": "#/$defs/entityRef"}}, "controls": {}, "factors": {}, "constraints": {}, "success_criteria": {},
        "agenda_status": {"enum": ["proposed", "active", "completed", "failed", "abandoned"]},
        "topics": {"$ref": "#/$defs/textArray"}, "result_kind": {"enum": ["improvement", "degradation", "insufficient_evidence", "scope_boundary"]},
        "scope": {"type": "object", "additionalProperties": false, "required": ["description", "dataset_scope_ids", "conditions"], "properties": {"description": {"type": "string", "minLength": 1}, "dataset_scope_ids": {"type": "array", "items": {"$ref": "#/$defs/entityRef"}}, "conditions": {"$ref": "#/$defs/textArray"}}},
        "limitations": {"$ref": "#/$defs/textArray"}, "source_annotation_ids": {"type": "array", "items": {"$ref": "#/$defs/entityRef"}},
        "kind": {"enum": ["loop", "analysis", "follow_up"]}, "title": {"type": "string", "minLength": 1}, "loop_id": {"type": "string", "minLength": 1},
        "related_loop_id": {"$ref": "#/$defs/entityRef"}, "report_locations": {"$ref": "#/$defs/textArray"}, "artifact_locations": {"$ref": "#/$defs/textArray"},
        "checkpoint": {"type": "object"}, "activity_id": {"$ref": "#/$defs/entityRef"}, "locations": {"$ref": "#/$defs/textArray"}, "purpose": {"type": "string", "minLength": 1},
        "evidence_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "scientific_review": {"enum": ["accepted", "rejected", "inconclusive"]},
        "basis": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "project_key": {"type": "string", "minLength": 1}, "dataset_key": {"type": "string", "minLength": 1}, "data_revision": {"type": "string", "minLength": 1},
        "overlap_keys": {"$ref": "#/$defs/textArray"}, "coverage": {"enum": ["declared_complete", "partial", "unknown"]}, "initial_observation": {"enum": ["declared_unobserved", "unknown"]},
        "dataset_scope_id": {"$ref": "#/$defs/entityRef"}, "event_kind": {"enum": ["scope_declared", "candidate_frozen", "first_scored", "promoted_to_development"]},
        "occurred_at": {"type": "string", "format": "date-time"}, "candidate_fingerprint": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string", "minLength": 1},
        "attempt_key": {"type": "string", "minLength": 1}, "execution_status": {"enum": ["succeeded", "failed", "interrupted", "unknown"]},
        "artifact_status": {"enum": ["none", "partial", "complete", "unknown"]}, "evaluation_status": {"enum": ["not_run", "passed", "failed", "inconclusive", "unknown"]},
        "audit_status": {"enum": ["not_run", "passed", "failed", "unknown"]}, "summary": {"type": "string", "minLength": 1}, "resources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "unit", "planned", "verification", "enforcement"], "properties": {"kind": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "planned": {"type": "number", "minimum": 0}, "actual": {"type": "number", "minimum": 0}, "verification": {"enum": ["verified", "unverified"]}, "enforcement": {"enum": ["executor_enforced", "declared_only", "unknown"]}, "source": {"type": "string", "minLength": 1}}}},
        "retry_of": {"$ref": "#/$defs/entityRef"}, "round": {"type": "integer", "minimum": 1}, "slot_id": {"type": "string"}, "native_task_id": {"type": "string"},
        "requested_settings": {"type": "object"}, "actual_settings": {"type": "object"}, "experiment_contract": {"$ref": "#/$defs/experimentContract"}, "result_commit_id": {"type": "string"}
      }
    }
  }
}
